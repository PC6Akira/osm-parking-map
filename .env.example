# 数据库连接配置（复制为 .env 后按实际修改）
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=parking_db

# 服务端口
PORT=3000

# JWT 认证（复制为 .env 后请改成随机长字符串）
JWT_SECRET=please_change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# 管理员登录额外密钥（仅存 .env，勿提交）
ADMIN_SECRET=please_change_me_to_a_random_string

# 管理员初始密码（初始化脚本用，默认 admin123）
ADMIN_PASSWORD=admin123
